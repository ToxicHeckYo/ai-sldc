{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc-orchestrator.local/schemas/spec-change.schema.json",
  "title": "Specification change package",
  "type": "object",
  "required": ["change", "delta"],
  "additionalProperties": false,
  "properties": {
    "change": {
      "type": "object",
      "required": ["id", "title", "status", "affects"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^CHG-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "applied"]},
        "affects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "references": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "delta": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "id", "title", "body"],
        "additionalProperties": false,
        "properties": {
          "operation": {"enum": ["ADDED", "MODIFIED", "REMOVED"]},
          "id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
          "title": {"type": "string"},
          "body": {"type": "string"}
        }
      }
    }
  }
}
