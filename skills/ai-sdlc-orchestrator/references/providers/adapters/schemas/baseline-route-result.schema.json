{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "base_revision", "outcome", "sections", "evidence", "files", "produced", "unresolved", "lifecycle_changes", "project_state_changes", "control_file_changes"],
  "properties": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"const": "1"}
      }
    },
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "outcome": {"enum": ["complete", "partial", "blocked", "failure"]},
    "sections": {"type": "object", "additionalProperties": {"type": "string"}},
    "evidence": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "items": {"type": "object"}}]}},
    "files": {"type": "object", "additionalProperties": {"type": "string"}},
    "produced": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "lifecycle_changes": {"type": "array", "maxItems": 0},
    "project_state_changes": {"type": "array", "maxItems": 0},
    "control_file_changes": {"type": "array", "maxItems": 0}
  }
}
