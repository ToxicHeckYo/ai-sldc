{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "base_revision", "outcome", "analysis", "artifacts", "evidence", "files"],
  "properties": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"const": "requirements-analysis"},
        "revision": {"const": "e02ec7e226a6e4f8419fd3b88a1d8e472d421b32"}
      }
    },
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "outcome": {"enum": ["complete", "partial", "blocked", "failure"]},
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "conflicts", "constraints", "assumptions", "open_questions"],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": {"type": "string", "pattern": "\\S"},
              "statement": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "conflicts": {"$ref": "#/$defs/strings"},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmed", "preferences"],
          "properties": {
            "confirmed": {"$ref": "#/$defs/strings"},
            "preferences": {"$ref": "#/$defs/strings"}
          }
        },
        "assumptions": {"$ref": "#/$defs/strings"},
        "open_questions": {"$ref": "#/$defs/strings"}
      }
    },
    "artifacts": {"$ref": "#/$defs/strings"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "traceability"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "checksum"],
            "properties": {
              "source_id": {"type": "string", "pattern": "\\S"},
              "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "traceability": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["source", "target", "relation"], "properties": {"source": {"type": "string", "pattern": "\\S"}, "target": {"type": "string", "pattern": "\\S"}, "relation": {"const": "traces_to"}}}
        }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {"pattern": "^staging/requirements(?:/[^/]+)+$"},
      "additionalProperties": {"type": "string"}
    },
    "lifecycle_changes": {"type": "array", "maxItems": 0},
    "project_state_changes": {"type": "array", "maxItems": 0},
    "control_file_changes": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}
  }
}
